PORT=3000

# MySQL do banco administrativo (HOST, USER e PASSWORD obrigatórios). Os bancos de trabalho ficam em
# <MYSQL_ADMIN_DATABASE>.servidores (id, descricao, mysql_host/port/user/password/database): no login o usuário
# digita o número do servidor, como no bi.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ADMIN_DATABASE=printcontrol_admin

# Chave que assina os tokens de sessão. Sem ela, uma chave aleatória é gerada a cada
# reinício do servidor e todos precisam entrar de novo.
SESSION_SECRET=

# E-mail (OS, notas de débito, cobrança). No Delphi era fixo no código.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Pasta dos arquivos (local, sem Vercel Blob)
STORAGE_DIR=./storage

# Caminho do Edge/Chrome usado para gerar os PDFs (opcional; sem ele, procura nos locais padrão)
NAVEGADOR_PDF=

# Vercel Blob (store "printcontrol"). Sem ele, os arquivos ficam no disco (STORAGE_DIR)
BLOB_READ_WRITE_TOKEN=

# Mostra no menu as opções que no Delphi só apareciam com dev.txt (Vendas, Estoque, Requisições)
VITE_MENU_DEV=

# NF-e: responsável técnico (infRespTec). No Delphi era fixo BMSoft
NFE_RESPTEC_CNPJ=
NFE_RESPTEC_CONTATO=
NFE_RESPTEC_EMAIL=
NFE_RESPTEC_FONE=
